# ============================================================
# Frontend Environment Configuration (Vite)
# ============================================================

# Permanent Backend API URL
# Configure this in Netlify: Site configuration -> Environment variables -> Add a variable
# Example with Render (Recommended Cloud Backend):
# VITE_API_URL=https://your-app-name.onrender.com

# Example with Permanent Static Ngrok Domain:
# VITE_API_URL=https://your-domain.ngrok-free.app

# Note: If left empty or unset, the frontend connects to same-origin /api
# which works seamlessly with Netlify API proxy redirects in netlify.toml!
