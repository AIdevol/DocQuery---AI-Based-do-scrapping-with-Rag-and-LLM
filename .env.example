# OPTION 1: Permanent Static Ngrok Domain (If running backend locally on Mac)
# Claim 1 free permanent domain at: https://dashboard.ngrok.com/cloud-edge/domains
# NGROK_DOMAIN=your-static-domain.ngrok-free.app

# Server Port (Default: 3001)
PORT=3001

# Optional AI Provider API Keys (Can also be added directly in the web UI Settings)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
